{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build current file",
            "type": "shell",
            "command": "${config:cppSingleFile.compiler}",
            "args": [
                "-std=c++20",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-o",
                "${fileDirname}/output/${fileBasenameNoExtension}",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
